{
  "name": "tempy-mcp",
  "version": "0.1.1",
  "description": "MCP server for disposable email inboxes via mail.tm",
  "type": "module",
  "bin": {
    "tempy": "dist/index.js",
    "tempy-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && npm run copy-ui",
    "copy-ui": "rm -rf dist/ui && cp -r src/ui dist/ui",
    "postbuild": "chmod +x dist/index.js",
    "start": "node dist/index.js",
    "test": "vitest run",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "email",
    "disposable",
    "testing",
    "mail.tm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidodejobi/tempy.git"
  },
  "homepage": "https://github.com/davidodejobi/tempy#readme",
  "bugs": {
    "url": "https://github.com/davidodejobi/tempy/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
